{
  "realm": "safecampus",
  "enabled": true,
  "sslRequired": "none",
  "internationalizationEnabled": true,
  "loginTheme": "keycloak",
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa",
        "providerId": "rsa",
        "config": {
          "priority": ["100"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "privateKey": [""],
          "publicKey": [""]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      { "name": "STUDENT", "description": "Student role" },
      { "name": "ADMIN", "description": "Administrator role" },
      { "name": "OPERATOR", "description": "Operator role" },
      { "name": "MAINTENANCE", "description": "Maintenance role" }
    ]
  },
  "clients": [
    {
      "clientId": "safecampus-frontend",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:3000",
        "http://localhost:3000/*",
        "http://localhost:3000"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "safecampus-backend",
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "bearerOnly": true,
      "clientAuthenticatorType": "client-secret",
      "attributes": {
        "oauth2.token.exchange.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      }
    }
  ],
  "users": [
    {
      "username": "student",
      "email": "student@safecampus.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "John",
      "lastName": "Student",
      "credentials": [
        {
          "type": "password",
          "value": "student123",
          "temporary": false
        }
      ],
      "realmRoles": ["STUDENT"]
    },
    {
      "username": "admin",
      "email": "admin@safecampus.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "operator",
      "email": "operator@safecampus.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Operator",
      "credentials": [
        {
          "type": "password",
          "value": "operator123",
          "temporary": false
        }
      ],
      "realmRoles": ["OPERATOR"]
    },
    {
      "username": "maintenance",
      "email": "maintenance@safecampus.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Charlie",
      "lastName": "Maintenance",
      "credentials": [
        {
          "type": "password",
          "value": "maintenance123",
          "temporary": false
        }
      ],
      "realmRoles": ["MAINTENANCE"]
    }
  ]
}
